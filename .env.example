APP_NAME=AI Healthcare Voice Assistant
APP_ENV=development
API_V1_PREFIX=/api/v1
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
POSTGRES_DB=healthcare_db
POSTGRES_USER=healthcare_user
POSTGRES_PASSWORD=replace_with_a_unique_random_password_at_least_24_characters
# URL-encode reserved characters in the password before placing it in DATABASE_URL.
DATABASE_URL=postgresql+psycopg://healthcare_user:replace_with_a_unique_random_password_at_least_24_characters@db:5432/healthcare_db
VITE_API_BASE_URL=http://localhost:8000/api/v1
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=replace_with_a_different_random_password_at_least_24_characters

# Generate secrets locally; do not reuse the examples above:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=replace_with_a_random_64_character_secret
ACCESS_TOKEN_MINUTES=20
PASSWORD_RESET_MINUTES=30
AUTH_RATE_LIMIT_ATTEMPTS=5
AUTH_RATE_LIMIT_WINDOW_SECONDS=60

# Optional SMTP configuration enables the password-reset email flow.
# Without SMTP_HOST and SMTP_FROM_EMAIL, reset requests fail with an explicit setup error.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_STARTTLS=true
# Optional notification SMS adapter. The HTTPS endpoint receives JSON: {"to": "+<E.164>", "message": "..."}.
# Store provider credentials only in the backend environment; email/SMS failures never roll back care workflows.
SMS_API_URL=
SMS_API_TOKEN=
APP_PUBLIC_URL=http://localhost:3000
# Required only for first-time web setup. Generate a unique token with: openssl rand -hex 32
ADMIN_BOOTSTRAP_TOKEN=

# CareVoice AI Healthcare Assistant Configuration
# Configurable LLM Provider: Modern AI_* variables or legacy LLM_* variables are supported and kept in sync.
# Default Local Mode: Ollama with quantized model llama3.2:1b-instruct-q4_K_M (runs completely offline).
# Hosted Mode: Set AI_PROVIDER=openai_compatible, AI_MODEL=gpt-6-astra, AI_BASE_URL=https://api.openai.com/v1, AI_API_KEY.
AI_PROVIDER=ollama
AI_MODEL=llama3.2:1b-instruct-q4_K_M
AI_BASE_URL=http://ollama:11434/v1
AI_API_KEY=

# Legacy LLM_* configuration (automatically synchronized with AI_*)
LLM_PROVIDER=ollama
LLM_API_KEY=
LLM_BASE_URL=http://ollama:11434/v1
LLM_MODEL=llama3.2:1b-instruct-q4_K_M
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1000
LLM_TIMEOUT_SECONDS=45
LLM_MAX_RETRIES=2
RAG_ENABLED=true

# Speech-to-text: browser uses the browser's recognition API.
# openai_compatible uses POST {base URL}/audio/transcriptions and can reuse LLM_API_KEY.
# indicconformer uses an operator-hosted adapter URL; see docs/speech_to_text.md.
SPEECH_TO_TEXT_PROVIDER=browser
SPEECH_TO_TEXT_BASE_URL=
SPEECH_TO_TEXT_API_KEY=
SPEECH_TO_TEXT_MODEL=whisper-1
SPEECH_TO_TEXT_TIMEOUT_SECONDS=45
SPEECH_TO_TEXT_MAX_AUDIO_BYTES=10485760

# RAG is opt-in. "hash" is an offline lexical baseline, not a semantic embedding model.
# For semantic vectors, select "ollama" or "openai_compatible" and configure model/API access.
# Re-ingest approved documents after changing the embedding provider/model.
EMBEDDING_PROVIDER=hash
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_TIMEOUT_SECONDS=15
EMBEDDING_DIMENSIONS=384
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=100
RAG_APPROVED_SOURCE_HOSTS=who.int,mohfw.gov.in,mohfw.nic.in,nhs.uk,cdc.gov
PROVIDER_MATCH_SPECIALTY_WEIGHT=0.55
PROVIDER_MATCH_CITY_WEIGHT=0.2
PROVIDER_MATCH_LANGUAGE_WEIGHT=0.15
PROVIDER_MATCH_CONSULTATION_WEIGHT=0.1

# Development default is an explicitly simulated checkout. To open Razorpay-hosted
# Razorpay Test Mode checkout, change this to live and provide only rzp_test_ keys.
# Production rejects demo mode.
PAYMENT_MODE=demo
# manual_review requires an authorized hospital/platform admin; no_refunds disables refund requests.
APPOINTMENT_REFUND_POLICY=manual_review
# Used only when PAYMENT_MODE=live. Never commit real keys.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_API_BASE_URL=https://api.razorpay.com/v1
# Optional. ID of the UPI-enabled Checkout Payment Configuration created in the Dashboard.
RAZORPAY_CHECKOUT_CONFIG_ID=
